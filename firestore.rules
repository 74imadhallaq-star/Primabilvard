rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    function validPendingBooking() {
      return request.resource.data.keys().hasAll([
        'id', 'name', 'email', 'phone', 'registration', 'service', 'size',
        'date', 'time', 'price', 'paymentStatus', 'sortKey'
      ])
        && request.resource.data.paymentStatus == 'Pending';
    }

    function validPaidBooking() {
      return request.resource.data.keys().hasAll([
        'id', 'name', 'email', 'phone', 'registration', 'service', 'size',
        'date', 'time', 'price', 'paymentStatus', 'sortKey'
      ])
        && request.resource.data.paymentStatus == 'Paid';
    }

    match /pendingBookings/{bookingId} {
      allow create: if validPendingBooking();
      allow read, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if validPaidBooking();
      allow read, update, delete: if isAdmin();
    }

    match /availability/{bookingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blockedDates/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blockedTimes/{timeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}