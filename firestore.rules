rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == '74imadhallaq@gmail.com';
    }

    function validPendingBooking() {
      return request.resource.data.keys().hasAll([
        'id', 'name', 'email', 'phone', 'registration', 'service', 'size',
        'date', 'time', 'price', 'paymentStatus', 'sortKey'
      ])
        && request.resource.data.paymentStatus == 'Pending'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.registration is string
        && request.resource.data.service is string
        && request.resource.data.size is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.price is number
        && request.resource.data.sortKey is number;
    }

    match /pendingBookings/{bookingId} {
      allow create: if validPendingBooking();
      allow read, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read, write: if isAdmin();
    }

    match /availability/{bookingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blockedDates/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blockedTimes/{timeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}